{
	"name": "quote-slicer-docs",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:22",
	"forwardPorts": [5173, 4173, 6006],
	"portsAttributes": {
		"5173": {
			"label": "SvelteKit dev",
			"onAutoForward": "notify"
		},
		"4173": {
			"label": "SvelteKit preview",
			"onAutoForward": "notify"
		},
		"6006": {
			"label": "Storybook",
			"onAutoForward": "notify"
		}
	},
	"secrets": {
		"FONTAWESOME_TOKEN": {
			"description": "Font Awesome package token required to install the private @awesome.me dependency."
		}
	},
	"postCreateCommand": "bash .devcontainer/setup.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss"
			]
		}
	}
}
